{
  "name": "austyle-support-backend",
  "private": true,
  "scripts": {
    "dev": "npm run start:dev",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/core.test.js dist-test/ai.test.js dist-test/http.test.js",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@supabase/supabase-js": "^2.57.0",
    "nodemailer": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
