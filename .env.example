# Copy to .env at workspace root. Never put these values in NEXT_PUBLIC variables.
PORT=3001
# Railway: HOST=0.0.0.0; PORT is supplied by Railway.
HOST=127.0.0.1
# For persistent email captures on Railway, mount a volume and set DATA_DIR=/data.
DATA_DIR=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Choose gemini, openai or demo. Keys stay on the NestJS server.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional alternative provider; not needed when using Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=
# Email is captured locally until explicitly enabled and configured.
MAIL_MODE=capture
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SUPPORT_FROM=
SUPPORT_TO=
# Optional: apply supabase/schema.sql before enabling cloud persistence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
